        "data/**",
        "docs/listing.example.json"
      ],
      "reason": "Listings, review/boost receipts and JSON data/template stay unchanged and shared."
    },
    {
      "paths": [
        "site/**",
        "vendor/**",
        "docs/vendor/**"
      ],
      "reason": "Website UI, assets and vendor/license documentation stay unchanged and shared."
    },
    {
      "paths": [
        "docs/i18n/**"
      ],
      "reason": "Translation mirrors, their administrative maintenance index and manifest are not recursive translation sources."
    }
  ],
  "untranslated_historical_materials": [],
